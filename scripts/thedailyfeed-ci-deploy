#!/usr/bin/env python3
"""Install this file outside the checkout as a root-owned SSH forced command."""
from contextlib import ExitStack
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile

CONFIG = Path('/etc/thedailyfeed/deploy.json')
phase = 'authorize'
log = None


def fail(reason):
    print(f'phase={phase} status=failed reason={reason}', file=sys.stderr)
    raise SystemExit(1)


def protected(path):
    """Administrator-owned configuration and every parent must resist user writes."""
    if not path.is_absolute() or path.is_symlink():
        fail('unsafe-config-path')
    for entry in (path, *path.parents):
        info = entry.stat()
        if info.st_uid != 0 or info.st_mode & 0o022 or entry.is_symlink():
            fail('unsafe-config-permissions')


def run(*args, capture=False, timeout=60):
    result = subprocess.run(args, stdout=subprocess.PIPE if capture else log,
                            stderr=log, text=True, timeout=timeout, check=False)
    if result.returncode:
        fail('command-failed')
    return result.stdout.strip() if capture else None


def require(condition, reason):
    if not condition:
        fail(reason)


def runtime(container, cfg, version=None, commit=None):
    expected = cfg['runtime']
    host = container['HostConfig']
    config = container['Config']
    env = dict(entry.split('=', 1) for entry in config.get('Env', []) if '=' in entry)
    require(container['State']['Health']['Status'] == 'healthy', 'container-unhealthy')
    require(config['User'] == expected['user'], 'runtime-user')
    require(host.get('ReadonlyRootfs') and not host.get('Privileged'), 'runtime-filesystem')
    require(set(host.get('CapDrop') or []) == {'ALL'} and not host.get('CapAdd'), 'runtime-capabilities')
    require(any(v in ('no-new-privileges', 'no-new-privileges:true') for v in host.get('SecurityOpt') or []), 'runtime-privileges')
    for key in ('PortBindings', 'Memory', 'NanoCpus', 'PidsLimit', 'Tmpfs', 'LogConfig'):
        require(host.get(key) == expected[key], 'runtime-' + key.lower())
    require(set(container['NetworkSettings']['Networks']) == set(expected['networks']), 'runtime-networks')
    require(not any(m.get('RW') and m.get('Type') != 'tmpfs' for m in container.get('Mounts', [])), 'runtime-writable-mount')
    labels = config.get('Labels') or {}
    require(labels.get('com.docker.compose.project') == cfg['project'], 'runtime-project')
    for key, value in expected['labels'].items():
        require(labels.get(key) == value, 'runtime-labels')
    require(not any(key.startswith(prefix) for key in labels for prefix in expected.get('forbidden_label_prefixes', [])), 'runtime-forbidden-label')
    require(env.get('ALLOW_PRIVATE_NETWORKS') == 'false', 'runtime-ssrf')
    if expected.get('metrics_required'):
        require(bool(env.get('METRICS_AUTH_TOKEN')), 'runtime-metrics-auth')
    if version is not None:
        require(env.get('APP_VERSION') == version and env.get('APP_COMMIT') == commit, 'runtime-metadata')


def deploy_release(resources):
    global phase, log
    match = re.fullmatch(r'deploy ([0-9a-f]{40})', os.environ.get('SSH_ORIGINAL_COMMAND', ''))
    require(match is not None, 'invalid-command')
    target = match[1]
    protected(CONFIG)
    cfg = json.loads(CONFIG.read_text())
    protected(Path(cfg['compose_file']))
    repository = Path(cfg['repository'])
    os.chdir(repository)
    # Keep all command output private, including fetch, build and failure details.
    os.umask(0o077)
    lock = resources.enter_context(open(repository / '.git/thedailyfeed-deploy.lock', 'a'))
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fail('deployment-locked')
    log = tempfile.NamedTemporaryFile(mode='w+', prefix='thedailyfeed-deploy-', suffix='.log',
                                      dir=repository / '.git', delete=False)
    resources.callback(log.close)
    phase = 'preflight'
    require(run('git', 'branch', '--show-current', capture=True) == 'main', 'branch-mismatch')
    require(run('git', 'remote', 'get-url', 'origin', capture=True) == cfg['expected_origin'], 'origin-mismatch')
    require(not run('git', 'status', '--porcelain', '--untracked-files=all', capture=True), 'dirty-worktree')
    env_file = Path(cfg['env_file'])
    require(env_file.is_file() and stat.S_IMODE(env_file.stat().st_mode) == 0o600, 'environment-file-mode')
    current = json.loads(run('docker', 'inspect', cfg['container'], capture=True))[0]
    runtime(current, cfg)
    phase = 'fetch'
    run('git', 'fetch', '--quiet', 'origin', 'refs/heads/main:refs/remotes/origin/main')
    require(run('git', 'rev-parse', 'refs/remotes/origin/main', capture=True) == target, 'stale-or-arbitrary-commit')
    run('git', 'merge-base', '--is-ancestor', 'HEAD', target)
    run('git', 'merge', '--ff-only', '--quiet', target)
    require(run('git', 'rev-parse', 'HEAD', capture=True) == target, 'checkout-mismatch')
    require(not run('git', 'status', '--porcelain', '--untracked-files=all', capture=True), 'dirty-after-fast-forward')
    phase = 'validate'
    version = json.loads(Path('package.json').read_text())['version']
    require(re.fullmatch(r'(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)', version), 'invalid-version')
    os.environ.update(APP_VERSION=version, APP_COMMIT=target)
    compose = ['docker', 'compose', '--project-name', cfg['project'], '--project-directory', str(repository),
               '-f', cfg['compose_file'], '--env-file', cfg['env_file']]
    run(*compose, 'config', '--quiet')
    run('docker', 'image', 'inspect', current['Image'])
    run('docker', 'image', 'tag', current['Image'], cfg['rollback_tag'])
    phase = 'activate'
    print(f'phase=activate commit={target} status=started', flush=True)
    run(*compose, 'up', '-d', '--build', '--no-deps', '--wait', '--wait-timeout', '180',
        'thedailyfeed', timeout=1800)
    phase = 'acceptance'
    container = json.loads(run('docker', 'inspect', cfg['container'], capture=True))[0]
    runtime(container, cfg, version, target)
    print(f'phase=complete commit={target} version={version} health=healthy status=success')
    log.close()
    Path(log.name).unlink()


def main():
    with ExitStack() as resources:
        deploy_release(resources)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        fail('operation-error')
