{
  "name": "thedailyfeed",
  "version": "1.1.11",
  "description": "A focused RSS reader for today's articles.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://repos.astrazds.net/astrazds/thedailyfeed.git"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && pnpm verify:pwa-build",
    "deploy:compose": "sh scripts/deploy-compose.sh",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test --test-concurrency=1 \"tests/**/*.test.mts\"",
    "version:check": "node scripts/version-policy.mjs check",
    "version:bump": "node scripts/version-policy.mjs bump",
    "verify:pwa-build": "tsx scripts/verify-pwa-build.mts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rss-parser": "^3.13.0",
    "serwist": "9.5.12"
  },
  "devDependencies": {
    "@serwist/cli": "9.5.12",
    "@serwist/next": "9.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
