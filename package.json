{
  "name": "thedailyfeed",
  "version": "1.1.0",
  "description": "A focused RSS reader for today's articles.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://repos.astrazds.net/astrazds/thedailyfeed.git"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.33.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && pnpm verify:pwa-build",
    "deploy:compose": "sh scripts/deploy-compose.sh",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test --test-concurrency=1 \"tests/**/*.test.mts\"",
    "version:check": "node scripts/version-policy.mjs check",
    "version:bump": "node scripts/version-policy.mjs bump",
    "verify:pwa-build": "tsx scripts/verify-pwa-build.mts"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.7",
    "next": "16.2.10",
    "next-pwa": "^5.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
