# The Daily Feed - Environment Variables Template
# Copy this file to .env.local for local development

# Application
NODE_ENV=development
TZ=UTC

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_SERVICE_NAME=thedailyfeed
LOG_REDACT_FIELDS=authorization,cookie,set-cookie,password,token
APP_VERSION=dev
APP_COMMIT=local

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# Feed Fetching
FEED_TIMEOUT_MS=10000
FEED_RETRY_COUNT=3
FEED_OVERALL_TIMEOUT_MS=30000
FEED_CACHE_TTL_MS=3600000
FEED_CACHE_MAX_ENTRIES=200

# SSRF Protection
# Set to 'true' to allow fetching RSS feeds from private network IPs (e.g., 192.168.x.x)
ALLOW_PRIVATE_NETWORKS=false

# Operator Metrics
# Required in production to access GET /api/metrics with Authorization: Bearer <token>
# METRICS_AUTH_TOKEN=change-me

# Traefik (compose.yml defaults)
TRAEFIK_DOMAIN=dailyfeed.example.com
TRAEFIK_CERT_RESOLVER=route53
