# Copy to .env.production for Compose, or .env.local for development.
# No credentials or release metadata belong in this template.
APP_PORT=3000
TZ=UTC
LOG_LEVEL=info
LOG_FORMAT=json
FEED_TIMEOUT_MS=10000
FEED_RETRY_COUNT=3
FEED_OVERALL_TIMEOUT_MS=30000
FEED_REQUEST_TIMEOUT_MS=30000
FEED_CACHE_TTL_MS=3600000
FEED_CACHE_MAX_ENTRIES=200
ALLOW_PRIVATE_NETWORKS=false
# Metrics are disabled in production until METRICS_AUTH_TOKEN is configured.
# Generate and store a private token separately if you need operator metrics.
